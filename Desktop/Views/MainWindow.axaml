<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Desktop"
        xmlns:views="using:Desktop.Views"
        xmlns:vm="using:Desktop.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        
        d:DesignWidth="1000" d:DesignHeight="600"
        MinWidth="800" MinHeight="600"
        
        x:Class="Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Open PrismaMotion">
        
        <Window.DataTemplates>
                <DataTemplate DataType="vm:OpticalFlowVideoGeneratorViewModel">
                        <views:OpticalFlowVideoGenerator/>
                </DataTemplate>
                <DataTemplate DataType="vm:ViewportViewModel">
                        <views:GlViewport/>
                </DataTemplate>
        </Window.DataTemplates>
        
        <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
                        <Button Content="Generator" Command="{Binding GoToGeneratorCommand}" />
                        <Button Content="Viewport" Command="{Binding GoToViewportCommand}" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
</Window>
